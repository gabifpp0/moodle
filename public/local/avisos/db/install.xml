<TABLE NAME="local_avisos">

    <FIELDS>

        <FIELD
            NAME="id"
            TYPE="int"
            LENGTH="10"
            NOTNULL="true"
            SEQUENCE="true"
        />

        <FIELD
            NAME="title"
            TYPE="char"
            LENGTH="255"
            NOTNULL="true"
        />

        <FIELD
            NAME="message"
            TYPE="text"
            NOTNULL="true"
        />

        <FIELD
            NAME="enabled"
            TYPE="int"
            LENGTH="1"
            NOTNULL="true"
            DEFAULT="1"
        />

    </FIELDS>

</TABLE>